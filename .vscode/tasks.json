{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start HTTP Server",
      "type": "shell",
      "command": "npx",
      "args": [
        "http-server",
        ".",
        "-p",
        "5500",
        "-c-1",
        "-o"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "options": {
        "cwd": "${workspaceFolder}/docs"
      }
    },
    {
      "label": "Start Backend Server",
      "type": "shell",
      "command": "python3",
      "args": [
        "comfyui_web_interface.py"
      ],
      "group": {
        "kind": "build"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Start Dev Servers",
      "dependsOn": [
        "Start Backend Server",
        "Start HTTP Server"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "Validate HTML",
      "type": "shell",
      "command": "html-validate",
      "args": [
        "docs/*.html"
      ],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Fix CSP Formatting",
      "type": "shell",
      "command": "python3",
      "args": [
        "scripts/fix-csp-formatting.py"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Format HTML Files",
      "type": "shell",
      "command": "prettier",
      "args": [
        "--write",
        "docs/*.html",
        "docs/**/*.css",
        "docs/**/*.js"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Deploy to GitHub Pages",
      "type": "shell",
      "command": "git",
      "args": [
        "add",
        ".",
        "&&",
        "git",
        "commit",
        "-m",
        "Update website",
        "&&",
        "git",
        "push",
        "origin",
        "main"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new"
      }
    }
  ]
}
