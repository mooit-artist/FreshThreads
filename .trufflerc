# TruffleHog v3 Configuration for FreshThreads
# This is a YAML configuration file

# Global settings
chunk_size: 1024
concurrency: 8
no_verification: false
only_verified: false

# Detectors to exclude
exclude_detectors:
    - "uri"
    - "url"
    - "base64"
    - "email"

# Files to exclude from scanning
exclude_paths:
    - "ComfyUI/**/*"
    - "advanced-design-pipeline/**/*"
    - "design-output/**/*"
    - "node_modules/**/*"
    - ".git/**/*"
    - ".venv/**/*"
    - "__pycache__/**/*"
    - "*.pyc"
    - "*-report.json"
    - "*.log"
    - "test-reports/**/*"
    - "security-reports/**/*"
    - "docs/assets/products-config.json"
