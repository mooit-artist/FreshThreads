# Office 365 Email Integration Configuration Template
# Copy this file to .env and fill in your actual values

# Microsoft Graph API Configuration (Recommended method)
# Get these values from Azure App Registration:
# https://portal.azure.com > Azure Active Directory > App registrations

O365_CLIENT_ID=your_client_id_here
O365_CLIENT_SECRET=your_client_secret_here
O365_TENANT_ID=your_tenant_id_here

# Email Configuration
O365_FROM_EMAIL=hello@freshthreadsllc.com
O365_TO_EMAIL=hello@freshthreadsllc.com

# SMTP Configuration (Alternative/Fallback method)
# Use your Office 365 email credentials

O365_SMTP_SERVER=smtp-mail.outlook.com
O365_SMTP_PORT=587
O365_SMTP_USERNAME=your_email@yourdomain.com
O365_SMTP_PASSWORD=your_app_password_here

# Flask Configuration
FLASK_ENV=development
PORT=5001

# Logging
LOG_LEVEL=INFO
