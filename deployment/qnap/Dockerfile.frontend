# Frontend Dockerfile - Simulates GitHub Pages
FROM nginx:alpine

# Copy static files
COPY docs/ /usr/share/nginx/html/

# Copy custom nginx config for static serving
COPY deployment/qnap/frontend-nginx.conf /etc/nginx/conf.d/default.conf

# Create logs directory
RUN mkdir -p /var/log/nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
