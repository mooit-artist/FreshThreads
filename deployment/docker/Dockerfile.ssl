# Fresh Threads LLC - HTTPS-enabled Docker Configuration
# Multi-stage build for production with SSL support

# Production stage with HTTPS
FROM nginx:alpine AS production

LABEL maintainer="Fresh Threads LLC <admin@freshthreadsllc.com>"
LABEL description="Production HTTPS-enabled Fresh Threads website"

# Install required packages
RUN apk add --no-cache \
  bash \
  ca-certificates \
  curl \
  openssl \
  wget && \
  adduser -S freshthreads -u 1001 -G nginx && \
  mkdir -p /etc/ssl/certs && \
  mkdir -p /etc/ssl/private && \
  mkdir -p /var/log/nano_agent

# Copy website files
COPY docs/ /usr/share/nginx/html/

# Copy SSL-enabled Nginx configuration
COPY docker/nginx-ssl.conf /etc/nginx/nginx.conf

# Copy SSL certificates (will be generated by setup script)
COPY docker/ssl/certs/freshthreads.crt /etc/ssl/certs/freshthreads.crt
COPY docker/ssl/private/freshthreads.key /etc/ssl/private/freshthreads.key

# Copy startup script
COPY docker/start-nginx.sh /usr/local/bin/start-nginx.sh

# Set proper permissions
RUN chown -R root:nginx /usr/share/nginx/html && \
  chown -R root:nginx /var/cache/nginx && \
  chown -R root:nginx /var/log/nginx && \
  chown -R root:nginx /etc/nginx/conf.d && \
  chmod +x /usr/local/bin/start-nginx.sh && \
  chown root:nginx /etc/ssl/private/freshthreads.key && \
  chown root:nginx /etc/ssl/certs/freshthreads.crt && \
  chmod 640 /etc/ssl/private/freshthreads.key && \
  chmod 644 /etc/ssl/certs/freshthreads.crt && \
  mkdir -p /tmp/client_temp /tmp/proxy_temp_path /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp && \
  chown -R root:nginx /tmp/client_temp /tmp/proxy_temp_path /tmp/fastcgi_temp /tmp/uwsgi_temp /tmp/scgi_temp

# Don't switch to non-root user yet - nginx needs root to bind to port 443
# USER freshthreads# Expose HTTPS port (443) and HTTP port (80) for redirect
EXPOSE 80 443

# Health check for HTTPS
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f -k https://localhost:443/health || exit 1

# Start Nginx
CMD ["/usr/local/bin/start-nginx.sh"]
