{
  "name": "freshthreads-llc",
  "version": "1.0.0",
  "description": "FreshThreads LLC - Print-on-demand T-shirt business",
  "main": "docs/index.html",
  "scripts": {
    "dev": "http-server docs/ -p 5500 -c-1 -o",
    "format": "prettier --write docs/*.html docs/**/*.css docs/**/*.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/javascript/unit",
    "test:integration": "jest tests/javascript/integration",
    "test:e2e": "jest tests/javascript/e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mooit-artist/FreshThreads.git"
  },
  "keywords": [
    "t-shirts",
    "print-on-demand",
    "apparel",
    "e-commerce"
  ],
  "author": "FreshThreads LLC",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^30.0.5",
    "http-server": "^14.1.1",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "jest-fetch-mock": "^3.0.3",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "docs/**/*.js",
      "!docs/**/node_modules/**",
      "!docs/**/*.min.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
