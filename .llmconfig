# FreshThreads LLM Integration Configuration
# This file contains settings for local LLM operations

# LLM Server Configuration
LLM_URL="http://localhost:11434"
LLM_MODEL="dolphin-llama3"
LLM_TIMEOUT=30

# Project Configuration
PROJECT_NAME="FreshThreads LLC"
PROJECT_TYPE="e-commerce-static-site"
HOSTING_PLATFORM="github-pages"

# Analysis Settings
MAX_FILE_SIZE="1MB"
ANALYZE_EXTENSIONS=("html" "css" "js" "json" "md")
EXCLUDE_PATTERNS=("node_modules" ".git" "dist" "build")

# GitHub Pages Constraints
GITHUB_PAGES_CONSTRAINTS=(
    "no-server-side-languages"
    "no-backend-databases"
    "static-files-only"
    "file-size-limits"
    "https-enforced"
)

# Review Categories
REVIEW_CATEGORIES=(
    "code-quality"
    "github-pages-compatibility"
    "security"
    "performance"
    "accessibility"
    "seo"
    "user-experience"
)

# Output Settings
OUTPUT_FORMAT="markdown"
SAVE_REVIEWS=true
REVIEW_OUTPUT_DIR="reviews"

# Prompts Configuration
SYSTEM_PROMPT_PREFIX="You are analyzing the FreshThreads LLC project, a print-on-demand e-commerce website with Scandinavian minimalism design principles, deployed on GitHub Pages static hosting."

CONTEXT_INCLUDES=(
    "project-manifest"
    "github-pages-constraints"
    "design-principles"
    "business-model"
)
