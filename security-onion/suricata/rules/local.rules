# Local Suricata rules for FreshThreads website protection
# Custom rules for web application security monitoring

# Web application attack detection
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads SQL Injection Attempt"; flow:established,to_server; content:"select"; http_uri; content:"union"; http_uri; distance:0; sid:1000001; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads XSS Attempt"; flow:established,to_server; content:"<script"; http_uri; nocase; sid:1000002; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Path Traversal Attempt"; flow:established,to_server; content:"../"; http_uri; sid:1000003; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Command Injection Attempt"; flow:established,to_server; pcre:"/(\||;|&|\$\(|\`)/"; http_uri; sid:1000004; rev:1; classtype:web-application-attack;)

# Authentication bypass attempts
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Admin Access Attempt"; flow:established,to_server; content:"/admin"; http_uri; startswith; sid:1000005; rev:1; classtype:attempted-admin;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Login Brute Force"; flow:established,to_server; content:"POST"; http_method; content:"/auth"; http_uri; threshold:type both, track by_src, seconds 60, count 10; sid:1000006; rev:1; classtype:attempted-dos;)

# E-commerce specific attacks
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Price Manipulation Attempt"; flow:established,to_server; content:"price"; http_client_body; content:"0.00"; http_client_body; distance:0; within:20; sid:1000007; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Inventory Manipulation"; flow:established,to_server; content:"/inventory"; http_uri; content:"quantity"; http_client_body; pcre:"/quantity[\"']*\s*:\s*[\"']*-?\d{3,}/"; sid:1000008; rev:1; classtype:web-application-attack;)

# Payment processing security
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Credit Card Data in URL"; flow:established,to_server; pcre:"/\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|3[0-9]{13}|6(?:011|5[0-9]{2})[0-9]{12})\b/"; http_uri; sid:1000009; rev:1; classtype:policy-violation;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Checkout Bypass Attempt"; flow:established,to_server; content:"/order-success"; http_uri; content:"GET"; http_method; sid:1000010; rev:1; classtype:web-application-attack;)

# Bot and scraping detection
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Automated Scraping Detected"; flow:established,to_server; http_user_agent; content:"bot"; nocase; threshold:type both, track by_src, seconds 300, count 50; sid:1000011; rev:1; classtype:policy-violation;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Rapid Product Page Access"; flow:established,to_server; content:"/products"; http_uri; threshold:type both, track by_src, seconds 60, count 20; sid:1000012; rev:1; classtype:attempted-dos;)

# Content Security Policy violations
alert http $HTTP_SERVERS $HTTP_PORTS -> $EXTERNAL_NET any (msg:"FreshThreads CSP Violation Report"; flow:established,to_client; content:"Content-Security-Policy-Report-Only"; http_header; sid:1000013; rev:1; classtype:policy-violation;)

# Sensitive file access attempts
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Config File Access"; flow:established,to_server; content:".env"; http_uri; sid:1000014; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Git Repository Access"; flow:established,to_server; content:"/.git"; http_uri; startswith; sid:1000015; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Package.json Access"; flow:established,to_server; content:"package.json"; http_uri; sid:1000016; rev:1; classtype:web-application-attack;)

# API abuse detection
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads API Rate Limit Exceeded"; flow:established,to_server; content:"/api/"; http_uri; startswith; threshold:type both, track by_src, seconds 60, count 100; sid:1000017; rev:1; classtype:attempted-dos;)

# Suspicious headers
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Suspicious User Agent"; flow:established,to_server; http_user_agent; pcre:"/(?:sqlmap|nikto|nmap|masscan|nessus|openvas|burp|zap)/i"; sid:1000018; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Missing User Agent"; flow:established,to_server; http_user_agent; content:!"User-Agent"; sid:1000019; rev:1; classtype:policy-violation;)

# File upload security
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Malicious File Upload"; flow:established,to_server; content:"Content-Type"; http_header; content:"multipart/form-data"; http_header; fileext:"php"; sid:1000020; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FreshThreads Executable Upload Attempt"; flow:established,to_server; content:"Content-Type"; http_header; content:"multipart/form-data"; http_header; pcre:"/\.(exe|bat|cmd|com|scr|vbs|js|jar)$/i"; sid:1000021; rev:1; classtype:web-application-attack;)
