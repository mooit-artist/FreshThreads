# Default Suricata rules for basic protection
# Core rule set for network intrusion detection

# Basic HTTP protection
alert http any any -> any any (msg:"HTTP Version 1.0 request"; content:"HTTP/1.0"; sid:100001; rev:1;)
alert http any any -> any any (msg:"HTTP POST request"; content:"POST"; http_method; sid:100002; rev:1;)
alert http any any -> any any (msg:"HTTP GET request to admin"; content:"GET"; http_method; content:"/admin"; http_uri; sid:100003; rev:1;)

# Basic TCP/IP monitoring
alert tcp any any -> any any (msg:"TCP connection established"; flags:A+; sid:100004; rev:1;)
alert tcp any any -> any any (msg:"TCP SYN scan detected"; flags:S; threshold:type both, track by_src, seconds 60, count 10; sid:100005; rev:1;)

# DNS monitoring
alert dns any any -> any any (msg:"DNS query"; sid:100006; rev:1;)
alert dns any any -> any any (msg:"DNS response"; sid:100007; rev:1;)

# TLS/SSL monitoring
alert tls any any -> any any (msg:"TLS handshake"; sid:100008; rev:1;)
alert tls any any -> any any (msg:"TLS certificate"; sid:100009; rev:1;)

# ICMP monitoring
alert icmp any any -> any any (msg:"ICMP ping"; itype:8; sid:100010; rev:1;)
alert icmp any any -> any any (msg:"ICMP pong"; itype:0; sid:100011; rev:1;)

# File transfer monitoring
alert ftp any any -> any any (msg:"FTP connection"; sid:100012; rev:1;)
alert smtp any any -> any any (msg:"SMTP connection"; sid:100013; rev:1;)

# Basic malware detection
alert http any any -> any any (msg:"Suspicious executable download"; content:".exe"; http_uri; sid:100014; rev:1;)
alert http any any -> any any (msg:"Suspicious script download"; content:".vbs"; http_uri; sid:100015; rev:1;)

# Port scanning detection
alert tcp any any -> any 1:1024 (msg:"Port scan detected"; flags:S; threshold:type both, track by_src, seconds 60, count 5; sid:100016; rev:1;)
