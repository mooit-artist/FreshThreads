# FreshThreads Backend API
# Python Flask service for Printify proxy and payment processing

FROM python:3.13-alpine

LABEL maintainer="FreshThreads LLC"
LABEL description="Backend API service for FreshThreads - Handles Printify proxy and payments"

# Set working directory
WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S appgroup && \
  adduser -S appuser -u 1001 -G appgroup

# Install system dependencies
RUN apk add --no-cache \
  bash \
  curl \
  gcc \
  musl-dev \
  libffi-dev \
  openssl-dev \
  ca-certificates

# Install Python dependencies
COPY requirements.txt* ./
RUN pip install --no-cache-dir --upgrade pip && \
  pip install --no-cache-dir -r requirements.txt || \
  pip install --no-cache-dir flask flask-cors requests python-dotenv

# Copy application code
COPY *.py ./
COPY scripts/ ./scripts/
COPY config/ ./config/

# Create logs directory
RUN mkdir -p logs && \
  chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Expose port 8000
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Start the Flask application
CMD ["python", "printify_proxy.py"]
