# Custom SonarQube image with FreshThreads plugins
FROM sonarqube:25.7.0-community

# Switch to root to install plugins
USER root

# Install additional security plugins and set permissions
RUN curl -L https://github.com/sbaudoin/sonar-html/releases/latest/download/sonar-html-plugin.jar \
  -o /opt/sonarqube/extensions/plugins/sonar-html-plugin.jar && \
  curl -L https://github.com/SonarSource/sonar-css/releases/latest/download/sonar-css-plugin.jar \
  -o /opt/sonarqube/extensions/plugins/sonar-css-plugin.jar

# Add FreshThreads specific configurations
COPY sonarqube-config/sonar.properties /opt/sonarqube/conf/
COPY sonarqube-config/quality-profiles/ /opt/sonarqube/conf/profiles/

# Create custom quality gate for e-commerce security
COPY sonarqube-config/quality-gate.json /opt/sonarqube/conf/

# Set permissions
RUN chown -R sonarqube:sonarqube /opt/sonarqube/conf/ && \
  chown -R sonarqube:sonarqube /opt/sonarqube/extensions/

# Switch back to sonarqube user
USER sonarqube

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s \
  CMD curl -f http://localhost:9000/api/system/status || exit 1

EXPOSE 9000
