# Fresh Threads LLC - HTTPS Backend
FROM python:3.9-alpine

LABEL maintainer="Fresh Threads LLC <admin@freshthreadsllc.com>"
LABEL description="HTTPS-enabled backend API server for Fresh Threads"

# Set working directory
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S appgroup && \
  adduser -S appuser -u 1001 -G appgroup

# Install system dependencies including OpenSSL
RUN apk add --no-cache \
  bash \
  curl \
  gcc \
  musl-dev \
  libffi-dev \
  openssl-dev \
  ca-certificates \
  openssl

# Copy requirements first for better caching
COPY requirements.txt* ./

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
  pip install --no-cache-dir -r requirements.txt || \
  pip install --no-cache-dir flask flask-cors requests python-dotenv

# Copy application files
COPY *.py ./
COPY scripts/ ./scripts/
COPY config/ ./config/

# Create SSL directories and generate certificates
RUN mkdir -p /app/ssl/certs /app/ssl/private && \
  openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
  -keyout /app/ssl/private/backend.key \
  -out /app/ssl/certs/backend.crt \
  -subj "/C=US/ST=State/L=City/O=Fresh Threads LLC/OU=Backend/CN=freshthreadsllc.com" && \
  chmod 600 /app/ssl/private/backend.key && \
  chmod 644 /app/ssl/certs/backend.crt

# Create logs directory and set permissions
RUN mkdir -p logs && \
  chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Expose HTTPS port
EXPOSE 8443

# Health check for HTTPS backend
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f -k https://localhost:8443/health || exit 1

# Start the HTTPS-enabled Flask app
CMD ["python", "printify_proxy.py", "--ssl"]
