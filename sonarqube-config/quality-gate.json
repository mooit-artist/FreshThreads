{
  "name": "FreshThreads E-commerce Security",
  "description": "Custom quality gate for e-commerce security compliance including PCI DSS requirements",
  "conditions": [
    {
      "metric": "security_hotspots_reviewed",
      "operator": "LT",
      "threshold": "100"
    },
    {
      "metric": "vulnerabilities",
      "operator": "GT",
      "threshold": "0"
    },
    {
      "metric": "security_rating",
      "operator": "GT",
      "threshold": "1"
    },
    {
      "metric": "reliability_rating",
      "operator": "GT",
      "threshold": "1"
    },
    {
      "metric": "coverage",
      "operator": "LT",
      "threshold": "80"
    },
    {
      "metric": "duplicated_lines_density",
      "operator": "GT",
      "threshold": "5"
    },
    {
      "metric": "maintainability_rating",
      "operator": "GT",
      "threshold": "1"
    }
  ]
}
